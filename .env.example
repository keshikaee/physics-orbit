# ─── Physics Orbit — Environment Configuration ───
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ─── Supabase ───
# Supabase dashboard → Project Settings → API Keys.
# The "publishable" key (sb_publishable_…) or the legacy "anon" key both work here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ─── Supabase Service Role (server-side only — never expose to client) ───
# The "secret" key (sb_secret_…) or legacy "service_role" key.
# Only used by `npm run create-teacher`. Bypasses all security rules — keep it private.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# ─── Database connection (optional — only for `npm run db:push` / `db:status`) ───
# Supabase → Connect → connection string. Contains your database password: keep it private.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# Optional: if your network has no IPv6, connect via the IPv4 session pooler (Supabase → Connect → Session pooler host).
# SUPABASE_POOLER_HOST=aws-0-ap-northeast-1.pooler.supabase.com

# ─── App URL ───
# Used to build links in confirmation / password-reset emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: Site metadata ───
NEXT_PUBLIC_SITE_NAME=Physics Orbit
